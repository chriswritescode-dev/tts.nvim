" Test emoji removal functionality
lua << EOF
-- Clear any cached tts modules so source changes take effect
for k in pairs(package.loaded) do
  if k:find('^tts') then package.loaded[k] = nil end
end

-- Add repo lua directory to path
package.path = vim.fn.getcwd() .. "/lua/?.lua;" .. package.path

-- Initialize config with defaults so clean_markdown_text works
local config = require('tts.config')
config.setup({})

local utils = require('tts.utils')

-- Test cases for emoji removal
local test_cases = {
  {
    name = "Basic emoji",
    input = "Hello 😀 world 😊",
    expected = "Hello  world "
  },
  {
    name = "Mixed emoji and text",
    input = "This is 👍 good 👎 bad 🚀 awesome",
    expected = "This is  good  bad  awesome"
  },
  {
    name = "Emoji shortcodes",
    input = "This is :smile: and :wink:",
    expected = "This is  and "
  },
  {
    name = "Complex emoji sequences",
    input = "Family: 👨‍👩‍👧‍👦 and heart ❤️",
    expected = "Family:  and heart "
  },
  {
    name = "Unicode symbols that are not emoji",
    input = "Math: ∑∏∫ and arrows ←→↑↓",
    expected = "Math: ∑∏∫ and arrows ←→↑↓"
  },
  {
    name = "Mixed content with punctuation",
    input = "Great! 🎉 Amazing! ✨ Wonderful! 🌟",
    expected = "Great!  Amazing!  Wonderful! "
  },
  {
    name = "No emoji",
    input = "Just regular text without any emoji",
    expected = "Just regular text without any emoji"
  },
  {
    name = "Skin tone modifiers",
    input = "Thumbs up 👍👍🏻👍🏼👍🏽👍🏾👍🏿",
    expected = "Thumbs up "
  },
  {
    name = "Transport emoji",
    input = "Travel by 🚗🚕🚙🚌🚎🏎️🚓🚑🚒🚐",
    expected = "Travel by "
  },
  {
    name = "Food emoji",
    input = "Food: 🍎🍊🍋🍌🍉🍇🍓🫐🍈🍒🍑🥭🍍🥥🥝🍅🍆🥑🥦🥬🥒🌶️🫑🌽🥕🫒🧄🧅",
    expected = "Food: "
  }
}

print("Testing emoji removal...")
print("=" .. string.rep("=", 60))

local passed = 0
local failed = 0

for i, test in ipairs(test_cases) do
  local result = utils.clean_markdown_text(test.input)
  local success = result == test.expected
  
  if success then
    passed = passed + 1
    print(string.format("✅ Test %d: %s", i, test.name))
  else
    failed = failed + 1
    print(string.format("❌ Test %d: %s", i, test.name))
    print("   Input:    " .. tostring(test.input))
    print("   Expected: " .. tostring(test.expected))
    print("   Got:      " .. tostring(result))
  end
end

print("=" .. string.rep("=", 60))
print(string.format("Results: %d passed, %d failed", passed, failed))

if failed == 0 then
  print("🎉 All emoji removal tests passed!")
else
  print("⚠️  Some tests failed")
end

-- Test the standalone function
print("\nTesting standalone remove_emoji function:")
local standalone_test = "Hello 😀 world 😊 :smile:"
local standalone_result = utils.remove_emoji(standalone_test)
print("Input:    " .. standalone_test)
print("Output:   " .. standalone_result)
print("Expected: Hello  world  :smile:")

if failed > 0 then
  vim.cmd('cquit 1')
end
EOF